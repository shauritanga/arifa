# ─────────────────────────────────────────────────────────────
# ARIFA — environment configuration
# Copy to ".env.local" and fill in real values.
# ─────────────────────────────────────────────────────────────

# ─── Site ────────────────────────────────────────────────────
# Must be the public origin. Selcom's create-order call uses this to build the
# redirect/cancel/webhook URLs it hands back to the gateway.
NEXT_PUBLIC_SITE_URL="https://arifa.org"

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/arifa?schema=public"

# ─── Selcom Payment Gateway (Tanzania) ────────────────────────
# Get these from your Selcom merchant dashboard / integration team.
# Sandbox base URL: https://apigwtest2.selcommobile.com
# Production base URL: https://apigw.selcommobile.com
SELCOM_BASE_URL="https://apigw.selcommobile.com"
SELCOM_API_KEY=""
SELCOM_API_SECRET=""
SELCOM_VENDOR_ID=""
# Currency Selcom charges in (Selcom settles in TZS).
SELCOM_CURRENCY="TZS"
# Timeout (ms) for each outbound Selcom HTTP call. Optional, defaults to 15000.
SELCOM_TIMEOUT_MS="15000"

# All of SELCOM_API_KEY / SELCOM_API_SECRET / SELCOM_VENDOR_ID and
# NEXT_PUBLIC_SITE_URL are REQUIRED — payments fail fast (with a clear error) if
# any are missing. There is no mock gateway; point SELCOM_BASE_URL at the
# sandbox for testing and the production URL for live.
#
# NOTE: if this merchant account is shared with another ARIFA site (e.g.
# ICAFoW), confirm with Selcom that each site's webhook/redirect URLs are
# distinct per order (they are — see lib/selcom/client.js) so settlement never
# crosses between sites.

# ─── Admin dashboard (NextAuth) ──────────────────────────────
# Session signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=""
# Seed credentials for the FIRST admin user: `npx prisma db seed`.
# Re-running the seed resets this user's password (use it to recover a lockout).
# Every other admin is created from inside the dashboard, at /admin/users.
ADMIN_EMAIL="admin@arifa.org"
ADMIN_PASSWORD=""

# ─── Background reconciliation (cron) ────────────────────────
# Shared secret required to call /api/cron/reconcile-donations.
# Generate: openssl rand -base64 32
CRON_SECRET=""
# Minutes an unpaid checkout may stay open before the reconciler marks it
# CANCELLED (the gateway is re-checked first; never cancels a paid donation).
PAYMENT_ABANDON_MINUTES="60"
